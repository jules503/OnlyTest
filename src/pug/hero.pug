section.hero(aria-labelledby="hero-title" data-header-theme="transparent")
  .hero__main
    img.hero__image(
      src="/images/main-background.jpg"
      alt=""
      width="1920"
      height="800"
    )
    .hero__overlay
    .hero__fade
    .hero__body.container
      h1#hero-title.hero__title
        span.hero__title-line
          span.hero__title-text превращаем окружение
        span.hero__title-line.hero__title-line--accent
          span.hero__title-text в живые сады
      p.hero__subtitle Вертикальное озеленение для бизнеса. Преображаем бизнес центры, ТЦ, отели, рестораны и другие коммерческие помещения.
